# Vercel 서버리스 함수(api/dict.js)가 쓰는 국립국어원 Open API 키.
# 실제 값은 Vercel 프로젝트 > Settings > Environment Variables 에만 넣고, 이 파일은 이름만 보관합니다.
# 로컬에서 `vercel dev` 로 돌릴 때는 이 파일을 .env.local 로 복사해서 값을 채우세요.

# 표준국어대사전 (https://stdict.korean.go.kr/openapi/openApiInfo.do)
STDICT_KEY=

# 우리말샘 (https://opendict.korean.go.kr/service/openApiInfo)
URIMAL_KEY=
